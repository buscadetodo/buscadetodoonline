# API Configuration - Production
REACT_APP_API_URL=https://libremercadodev.daelsoft.com

# Environment
NODE_ENV=production

# Verificación de email y recupero de contraseña (R-004). Este build es el que
# abre el link del mail (FRONTEND_URL): sin el flag, /verificar-email da 404
REACT_APP_FEATURE_CUENTA_EMAIL=true
